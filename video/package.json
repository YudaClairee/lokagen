{
  "name": "lokagen-video",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphic video project for LokaGen using Remotion",
  "scripts": {
    "dev": "remotion studio --ipv4",
    "studio": "remotion studio --ipv4",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts LokaGenLandscape out/lokagen-landscape.mp4",
    "render:vertical": "remotion render src/index.ts LokaGenVertical out/lokagen-vertical.mp4",
    "render:rabu": "remotion render src/index.ts ReelsRabuAlurUMKM out/reels-rabu-alur-umkm.mp4",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "lucide-react": "^0.555.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/web": "^0.0.166",
    "typescript": "^5.8.2"
  }
}
