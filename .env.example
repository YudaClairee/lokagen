# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override the AI model (default: deepseek/deepseek-v4.1-flash-1017)
AI_MODEL=

# Password for the app login (required; no fallback)
AUTH_PASSWORD=

# Optional: URL form/WhatsApp untuk tombol "Kirim Masukan" saat product testing
NEXT_PUBLIC_FEEDBACK_URL=
