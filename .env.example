# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: override the AI model (default: deepseek/deepseek-v4.1-flash-1017)
AI_MODEL=

# Supabase (Auth Google + Kuota 3x Gratis)
# Ambil dari Supabase Dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: URL produksi untuk preview Open Graph saat link di-share (mis. https://lokagen.netlify.app)
NEXT_PUBLIC_SITE_URL=

# Optional: Link Google Form masukan untuk tombol "Kirim Masukan" & CTA saat kuota 3x habis
NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/X8Jzg2jRzUN7rpi49

# Optional: Link WhatsApp (mis. https://wa.me/62812xxxx?text=Halo%20LokaGen...) untuk request tambah kuota
NEXT_PUBLIC_WA_URL=
